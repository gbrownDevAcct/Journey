<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Journey Case Management Access</label>
    <description>Grants visibility to the Journey Case record types, plus field-level access to Journey's participant demographic fields.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <fieldPermissions>
        <field>Contact.JRNY_RaceEthnicity__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <recordTypeVisibilities>
        <recordType>Case.LIR</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Advocacy_Case</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Job_Readiness_Case</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Recovery_Planning_Case</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Inbound_Referral</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Outbound_Referral</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
    <recordTypeVisibilities>
        <recordType>Case.Crisis_Incident</recordType>
        <visible>true</visible>
    </recordTypeVisibilities>
</PermissionSet>
